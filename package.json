{
  "name": "studyts",
  "private": false,
  "version": "0.9.0",
  "type": "module",
  "bin": {
    "studyts": "./bin/studyts.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run db:ready && npm run db:seed && concurrently -n vite,server -c cyan,magenta \"vite\" \"tsx --env-file=.env server/index.ts --dev\"",
    "dev:browser": "node scripts/browser_qa/run.js --open",
    "dev:client": "vite",
    "stop:dev": "node stop-dev.cjs",
    "build": "tsc && vite build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:ready": "node scripts/ensure-prisma.cjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "start": "node start.cjs",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "qa:browser": "node scripts/browser_qa/run.js",
    "qa:browser:open": "node scripts/browser_qa/run.js --open",
    "qa:browser:setup": "node scripts/browser_qa/run.js --setup",
    "stop": "node stop.cjs",
    "studyts": "node scripts/browser_qa/run.js",
    "server": "tsx --env-file=.env server/index.ts",
    "update": "node scripts/update/cli.cjs apply",
    "update:check": "node scripts/update/cli.cjs check",
    "update:status": "node scripts/update/cli.cjs status",
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prepack": "npm run build",
    "build:server": "esbuild server/index.ts server/mcp/servers/studyTsServer.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outdir=dist-server --out-extension:.js=.mjs",
    "prepare": "node scripts/prepare-build.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/react": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "animejs": "^4.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "katex": "^0.16.10",
    "lucide-react": "^0.378.0",
    "pdfjs-dist": "^6.3.289",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "zustand": "^5.0.15",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fast-glob": "^3.3.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/",
    "server/",
    "src/",
    "prisma/schema.prisma",
    "prisma/migrations/",
    "prisma/catalogScanner.ts",
    "prisma/topicLoader.ts",
    "prisma/seed.ts",
    "locales/",
    "config/",
    "asset/",
    "public/",
    "vite-plugins/",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "scripts/update/",
    "scripts/writeFileAtomic.cjs"
  ]
}
