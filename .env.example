# Database (used by Prisma and backend)
DATABASE_URL="file:./studyts.db"

# AI provider fallback keys — used by POST /api/ai/chat only when a request
# doesn't supply its own key (Settings UI key always takes precedence).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Backend
# ALLOWED_ORIGINS=http://localhost:7300,http://127.0.0.1:7300 # browser origins allowed to call /api (comma-separated)
# BACKEND_PORT=7301
# BACKEND_URL=http://localhost:7301
# STUDYTS_LOG_DIR=.logs # Directory where run logs, crashes, and digests are kept (defaults to <cwd>/.logs)
# STUDYTS_VERBOSE_LOGS=0 # Set to 1 to echo info and debug logs to terminal (errors only by default)
# EXIT_ON_UNCAUGHT=0 # Set to 1 to terminate process and gracefully shutdown after uncaught exceptions

# Frontend (Vite)
# VITE_API_URL=http://localhost:7301
# VITE_DEBUG_MODE=false # Developer diagnostic overlay, bounding box wireframes, and latency logs
