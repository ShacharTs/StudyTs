  "templates": [
    {
      "id": "flowchart-login",
      "name": {
        "en": "Login flow",
        "he": "זרימת התחברות"
      },
      "category": "flowchart",
      "description": {
        "en": "Check credentials, then enter or retry.",
        "he": "בדיקת פרטים, כניסה או ניסיון חוזר."
      },
      "objects": [
        {
          "key": "start",
          "ref": "flowchart/terminator",
          "at": {
            "x": 0.1,
            "y": 0.5
          },
          "label": {
            "en": "Start",
            "he": "התחלה"
          }
        },
        {
          "key": "enter",
          "ref": "flowchart/process",
          "at": {
            "x": 0.325,
            "y": 0.5
          },
          "label": {
            "en": "Sign in",
            "he": "התחברות"
          }
        },
        {
          "key": "valid",
          "ref": "flowchart/decision",
          "at": {
            "x": 0.55,
            "y": 0.5
          },
          "label": {
            "en": "Valid?",
            "he": "תקין?"
          }
        },
        {
          "key": "dash",
          "ref": "flowchart/process",
          "at": {
            "x": 0.8125,
            "y": 0.5
          },
          "label": {
            "en": "Dashboard",
            "he": "לוח בקרה"
          }
        },
        {
          "key": "err",
          "ref": "flowchart/process",
          "at": {
            "x": 0.55,
            "y": 0.865
          },
          "label": {
            "en": "Show error",
            "he": "הצגת שגיאה"
          }
        }
      ],
      "links": [
        {
          "from": "start",
          "to": "enter"
        },
        {
          "from": "enter",
          "to": "valid"
        },
        {
          "from": "valid",
          "to": "dash",
          "label": {
            "en": "Yes",
            "he": "כן"
          }
        },
        {
          "from": "valid",
          "to": "err",
          "label": {
            "en": "No",
            "he": "לא"
          }
        },
        {
          "from": "err",
          "to": "enter",
          "route": "elbow",
          "fromPort": "w",
          "toPort": "s"
        }
      ],
      "steps": [
        {
          "caption": {
            "en": "The login starts at Start",
            "he": "ההתחברות מתחילה בהתחלה"
          },
          "show": [
            "start",
            "enter",
            "valid",
            "dash",
            "err"
          ],
          "effects": [
            {
              "effect": "glow",
              "target": "start"
            }
          ]
        },
        {
          "caption": {
            "en": "The user enters credentials",
            "he": "המשתמש מזין פרטים"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "start->enter"
            },
            {
              "effect": "glow",
              "target": "enter"
            }
          ]
        },
        {
          "caption": {
            "en": "The system checks them",
            "he": "המערכת בודקת אותם"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "enter->valid"
            },
            {
              "effect": "glow",
              "target": "valid"
            }
          ]
        },
        {
          "caption": {
            "en": "Valid: open the dashboard",
            "he": "תקין: פותחים את לוח הבקרה"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "valid->dash"
            },
            {
              "effect": "pulse",
              "target": "dash"
            }
          ]
        },
        {
          "caption": {
            "en": "Invalid: show an error",
            "he": "לא תקין: מוצגת שגיאה"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "valid->err"
            },
            {
              "effect": "glow",
              "target": "err"
            }
          ]
        },
        {
          "caption": {
            "en": "Back to entering credentials",
            "he": "חוזרים להזנת הפרטים"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "err->enter"
            },
            {
              "effect": "glow",
              "target": "enter"
            }
          ]
        }
      ]
    },
    {
      "id": "flowchart-loop",
      "name": {
        "en": "Loop until done",
        "he": "לולאה עד סיום"
      },
      "category": "flowchart",
      "description": {
        "en": "Repeat the work until the check passes.",
        "he": "חוזרים על העבודה עד שהבדיקה עוברת."
      },
      "objects": [
        {
          "key": "begin",
          "ref": "flowchart/terminator",
          "at": {
            "x": 0.1,
            "y": 0.5
          },
          "label": {
            "en": "Begin",
            "he": "התחלה"
          }
        },
        {
          "key": "work",
          "ref": "flowchart/process",
          "at": {
            "x": 0.325,
            "y": 0.5
          },
          "label": {
            "en": "Do the work",
            "he": "ביצוע העבודה"
          }
        },
        {
          "key": "done",
          "ref": "flowchart/decision",
          "at": {
            "x": 0.55,
            "y": 0.5
          },
          "label": {
            "en": "Done?",
            "he": "סיימנו?"
          }
        },
        {
          "key": "end",
          "ref": "flowchart/terminator",
          "at": {
            "x": 0.8125,
            "y": 0.5
          },
          "label": {
            "en": "End",
            "he": "סיום"
          }
        }
      ],
      "links": [
        {
          "from": "begin",
          "to": "work"
        },
        {
          "from": "work",
          "to": "done"
        },
        {
          "from": "done",
          "to": "work",
          "label": {
            "en": "No",
            "he": "לא"
          },
          "route": "curve",
          "fromPort": "n",
          "toPort": "n"
        },
        {
          "from": "done",
          "to": "end",
          "label": {
            "en": "Yes",
            "he": "כן"
          }
        }
      ],
      "steps": [
        {
          "caption": {
            "en": "Begin the loop",
            "he": "מתחילים את הלולאה"
          },
          "show": [
            "begin",
            "work",
            "done",
            "end"
          ],
          "effects": [
            {
              "effect": "glow",
              "target": "begin"
            }
          ]
        },
        {
          "caption": {
            "en": "Do one round of work",
            "he": "מבצעים סבב עבודה אחד"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "begin->work"
            },
            {
              "effect": "glow",
              "target": "work"
            }
          ]
        },
        {
          "caption": {
            "en": "Check whether it is done",
            "he": "בודקים אם סיימנו"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "work->done"
            },
            {
              "effect": "glow",
              "target": "done"
            }
          ]
        },
        {
          "caption": {
            "en": "Not done: repeat the work",
            "he": "לא סיימנו: חוזרים לעבודה"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "done->work"
            },
            {
              "effect": "glow",
              "target": "work"
            }
          ]
        },
        {
          "caption": {
            "en": "Check again",
            "he": "בודקים שוב"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "work->done"
            },
            {
              "effect": "glow",
              "target": "done"
            }
          ]
        },
        {
          "caption": {
            "en": "Done: leave the loop",
            "he": "סיימנו: יוצאים מהלולאה"
          },
          "show": [],
          "effects": [
            {
              "effect": "travel",
              "target": "done->end"
            },
            {
              "effect": "pulse",
              "target": "end"
            }
          ]
        }
      ]
    }
  ]
}
